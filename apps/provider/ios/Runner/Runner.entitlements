<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications: ตอน Archive เพื่อส่ง App Store Xcode เปลี่ยนเป็น production ตาม provisioning profile ให้เอง -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- แจ้งงานใหม่แบบ Time Sensitive: ทะลุโหมดโฟกัส/สรุปแจ้งเตือน (ไม่ต้องขออนุมัติจาก Apple)
	     ไม่ใส่ Critical Alerts (ดังแม้ปิดเสียง) เพราะต้องได้รับอนุมัติจาก Apple ก่อน ดู docs/PUSH.md -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- Sign in with Apple: เปิด capability นี้ใน App ID ด้วย ไม่งั้น provisioning profile ไม่ผ่าน -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
