# Caddy ขอใบรับรอง HTTPS จาก Let's Encrypt ให้อัตโนมัติ (DNS ต้องชี้มาที่เครื่องนี้ก่อน)

{$API_DOMAIN} {
	encode gzip
	# รูปจากแอปอัปโหลดตรงไป object storage ไม่ผ่าน API จึงจำกัด body ได้เล็ก
	request_body {
		max_size 2MB
	}
	reverse_proxy api:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
}

{$ADMIN_DOMAIN} {
	encode gzip
	root * /srv/admin
	file_server
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		-Server
	}
}
