# คัดลอกเป็น deploy/.env.production แล้วกรอกค่า ห้าม commit ไฟล์จริง
# ค่าที่ขึ้นต้น "change-me" ต้องเปลี่ยนเป็นค่าสุ่มยาว: openssl rand -hex 32

# ---------- โดเมน (DNS A record ต้องชี้มาที่ IP ของเครื่องนี้ก่อน) ----------
API_DOMAIN=api.fixgo.co.th
ADMIN_DOMAIN=admin.fixgo.co.th
# เว็บที่เรียก API จากเบราว์เซอร์ได้ (แอปมือถือไม่ใช้ CORS)
CORS_ORIGIN=https://admin.fixgo.co.th

# ---------- ฐานข้อมูล (compose สร้าง DATABASE_URL ให้เอง) ----------
POSTGRES_PASSWORD=change-me

# ---------- ความลับ ----------
JWT_SECRET=change-me
JWT_EXPIRES_SECONDS=2592000
OTP_SECRET=change-me

# ---------- Object storage (Cloudflare R2 / S3) ดู docs/DEPLOY.md ----------
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=fixgo-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://files.fixgo.co.th
S3_FORCE_PATH_STYLE=false

# ---------- SMS OTP: thaibulksms หรือ twilio ----------
SMS_PROVIDER=thaibulksms
THAIBULKSMS_API_KEY=
THAIBULKSMS_API_SECRET=
# ชื่อผู้ส่งที่ ThaiBulkSMS อนุมัติแล้ว เช่น FixGo
THAIBULKSMS_SENDER=
THAIBULKSMS_FORCE=corporate
# ใช้ Twilio แทน: SMS_PROVIDER=twilio แล้วกรอก 3 ค่านี้
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- ชำระเงิน ----------
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING_EMAIL=

# ---------- Push (Firebase) ----------
PUSH_PROVIDER=fcm
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ---------- ข้อมูลบริษัทในหน้า legal ----------
LEGAL_COMPANY_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_CONTACT_PHONE=
LEGAL_ADDRESS=
LEGAL_UPDATED_AT=

# ---------- บัญชีทดสอบของทีมรีวิว (ลบออกหลังรีวิวผ่าน) ----------
REVIEW_LOGIN_PHONES=
REVIEW_LOGIN_CODE=
