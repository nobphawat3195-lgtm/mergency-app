# คัดลอกเป็น deploy/.env.production แล้วกรอกค่า ห้าม commit ไฟล์จริง
# ค่าที่ขึ้นต้น "change-me" ต้องเปลี่ยนเป็นค่าสุ่มยาว: openssl rand -hex 32

# ---------- โดเมน (DNS A record ต้องชี้มาที่ IP ของเครื่องนี้ก่อน) ----------
API_DOMAIN=api.fixgo.co.th
ADMIN_DOMAIN=admin.fixgo.co.th
# เว็บแอปลูกค้า และเว็บแอปช่าง
WEB_DOMAIN=fixgo.co.th
FIXER_DOMAIN=fixer.fixgo.co.th
# เว็บที่เรียก API จากเบราว์เซอร์ได้ ต้องมีทั้ง 3 โดเมนข้างบน (แอปมือถือไม่ใช้ CORS)
CORS_ORIGIN=https://fixgo.co.th,https://fixer.fixgo.co.th,https://admin.fixgo.co.th

# ---------- ฐานข้อมูล (compose สร้าง DATABASE_URL ให้เอง) ----------
POSTGRES_PASSWORD=change-me

# ---------- ความลับ ----------
JWT_SECRET=change-me
JWT_EXPIRES_SECONDS=2592000
OTP_SECRET=change-me

# ---------- ที่เก็บรูป ----------
# local = เก็บบนดิสก์ของเซิร์ฟเวอร์นี้ (ฟรี ไม่ต้องสมัครอะไรเพิ่ม, backup.sh สำรองให้)
# ลบบรรทัดนี้ออกถ้าจะใช้ Cloudflare R2 / S3 แล้วกรอกค่า S3_* ข้างล่าง
STORAGE_PROVIDER=local

# ---------- Object storage (Cloudflare R2 / S3) ดู docs/DEPLOY.md ----------
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=fixgo-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://files.fixgo.co.th
S3_FORCE_PATH_STYLE=false

# ---------- SMS OTP: thaibulksms หรือ twilio ----------
SMS_PROVIDER=thaibulksms
THAIBULKSMS_API_KEY=
THAIBULKSMS_API_SECRET=
# ชื่อผู้ส่งที่ ThaiBulkSMS อนุมัติแล้ว เช่น FixGo
THAIBULKSMS_SENDER=
THAIBULKSMS_FORCE=corporate
# ใช้ Twilio แทน: SMS_PROVIDER=twilio แล้วกรอก 3 ค่านี้
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- ชำระเงิน ----------
# promptpay_manual = เงินเข้าพร้อมเพย์ของเจ้าของ แอดมินตรวจสลิป (ไม่มีค่าธรรมเนียม)
# stripe = ยืนยันยอดอัตโนมัติผ่าน webhook (ดู docs/PAYMENTS.md)
PAYMENT_PROVIDER=promptpay_manual
PROMPTPAY_ID=
PROMPTPAY_NAME=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING_EMAIL=

# ---------- Push (Firebase) ----------
PUSH_PROVIDER=fcm
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ---------- แจ้งเตือนทีมงาน (ไม่มีช่างรับงาน, ช่างสมัครใหม่, คำขอเบิก) ----------
# line = ส่งเข้ากลุ่ม LINE ผ่าน LINE Official Account (Messaging API), webhook = Slack/Discord
ADMIN_ALERT_CHANNEL=line
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_TO=
ADMIN_ALERT_WEBHOOK_URL=
ADMIN_URL=https://admin.fixgo.co.th

# ---------- Sentry (ไม่บังคับ) ----------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ---------- ข้อมูลบริษัทในหน้า legal ----------
LEGAL_COMPANY_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_CONTACT_PHONE=
LEGAL_ADDRESS=
LEGAL_UPDATED_AT=

# ---------- บัญชีทดสอบของทีมรีวิว (ลบออกหลังรีวิวผ่าน) ----------
REVIEW_LOGIN_PHONES=
REVIEW_LOGIN_CODE=
