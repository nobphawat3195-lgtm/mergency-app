# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามเครื่องของคุณ
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fixgo?schema=public"

# ความลับสำหรับเซ็น JWT — production ต้องเปลี่ยนเป็นค่าสุ่มยาว ๆ
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_SECONDS="2592000"

# ความลับสำหรับแฮช OTP
OTP_SECRET="change-me-in-production"

# ความลับที่ payment gateway ต้องส่งมาพร้อม webhook
PAYMENT_WEBHOOK_SECRET="change-me-in-production"

PORT=3000
# ใส่หลาย origin คั่นด้วย comma เช่น web ลูกค้า, web ช่าง, และหลังบ้าน
CORS_ORIGIN="http://localhost:8080,http://localhost:8081,http://localhost:5500"
NODE_ENV=development

# Object storage แบบ S3-compatible (AWS S3, Cloudflare R2, Backblaze B2 ฯลฯ)
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="fixgo-uploads"
S3_ACCESS_KEY_ID="change-me-in-production"
S3_SECRET_ACCESS_KEY="change-me-in-production"
S3_PUBLIC_BASE_URL="https://cdn.example.com"
S3_FORCE_PATH_STYLE="false"

# OTP SMS: development ใช้ console (พิมพ์รหัสลง log), production ตั้งเป็น thaibulksms หรือ twilio
SMS_PROVIDER="console"
# ThaiBulkSMS: หลังบ้าน > API Key (ชื่อผู้ส่งต้องขออนุมัติก่อน, force: corporate แนะนำสำหรับ OTP)
THAIBULKSMS_API_KEY=""
THAIBULKSMS_API_SECRET=""
THAIBULKSMS_SENDER=""
THAIBULKSMS_FORCE="corporate"
# Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# บัญชีทดสอบสำหรับทีมรีวิว App Store / Google Play (รับ SMS ไม่ได้)
# เบอร์ในรายการนี้ใช้รหัส REVIEW_LOGIN_CODE ตายตัวโดยไม่ส่ง SMS
# ใช้เบอร์ที่ไม่มีเจ้าของจริง แล้วลบออกหลังรีวิวผ่าน ดู docs/APP_REVIEW.md
REVIEW_LOGIN_PHONES=""
REVIEW_LOGIN_CODE=""

# ข้อมูลบริษัทในหน้านโยบายความเป็นส่วนตัว/ข้อตกลง (/api/legal/privacy, terms, delete-account, support)
# ถ้ายังไม่ตั้ง หน้าเว็บจะแสดงช่องว่างสีเหลือง ต้องกรอกก่อนส่งแอปเข้า store
LEGAL_COMPANY_NAME=""
LEGAL_CONTACT_EMAIL=""
LEGAL_CONTACT_PHONE=""
LEGAL_ADDRESS=""
LEGAL_UPDATED_AT=""

# ระบบรับชำระเงิน: stub (พัฒนา, QR จ่ายจริงไม่ได้), promptpay_manual (เงินเข้าพร้อมเพย์ของเจ้าของ แอดมินตรวจสลิป) หรือ stripe
PAYMENT_PROVIDER="stub"
# promptpay_manual: เบอร์มือถือหรือเลขประจำตัวผู้เสียภาษี 13 หลักที่ผูกพร้อมเพย์ และชื่อบัญชีที่ลูกค้าจะเห็นตอนโอน
PROMPTPAY_ID=""
PROMPTPAY_NAME=""
# Stripe: Dashboard > Developers > API keys (โหมดทดสอบขึ้นต้น sk_test_)
STRIPE_SECRET_KEY=""
# Stripe: Dashboard > Developers > Webhooks > endpoint /api/payments/stripe/webhook (ขึ้นต้น whsec_)
STRIPE_WEBHOOK_SECRET=""
# อีเมลผู้จ่ายที่ Stripe บังคับสำหรับพร้อมเพย์ (ว่างไว้จะใช้ LEGAL_CONTACT_EMAIL)
STRIPE_BILLING_EMAIL=""

# Push notification: console (พิมพ์ลง log ตอนพัฒนา) หรือ fcm
# Firebase Console > Project settings > Service accounts > Generate new private key
# คัดลอก project_id, client_email, private_key จากไฟล์ JSON (private_key ใส่ \n แทนขึ้นบรรทัดใหม่ได้)
PUSH_PROVIDER="console"
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# แจ้งเตือนทีมงาน (ไม่มีช่างรับงาน, ช่างสมัครใหม่, คำขอเบิกเงิน): none | line | webhook
# line: LINE Official Account > Messaging API > channel access token และ userId/groupId ของกลุ่มทีมงาน
# webhook: Slack หรือ Discord incoming webhook URL
ADMIN_ALERT_CHANNEL="none"
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_ADMIN_TO=""
ADMIN_ALERT_WEBHOOK_URL=""
# ลิงก์หน้าแอดมินที่แนบท้ายข้อความแจ้งเตือน
ADMIN_URL=""

# รายงาน error 500 ไป Sentry (ไม่ตั้ง = ปิด) ไม่ส่ง header/body/ข้อมูลผู้ใช้
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
SENTRY_TRACES_SAMPLE_RATE="0"
