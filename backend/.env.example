# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามเครื่องของคุณ
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fixgo?schema=public"

# ความลับสำหรับเซ็น JWT — production ต้องเปลี่ยนเป็นค่าสุ่มยาว ๆ
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="30d"

# ความลับสำหรับแฮช OTP
OTP_SECRET="change-me-in-production"

# ความลับที่ payment gateway ต้องส่งมาพร้อม webhook
PAYMENT_WEBHOOK_SECRET="change-me-in-production"

PORT=3000
CORS_ORIGIN="*"
NODE_ENV=development
